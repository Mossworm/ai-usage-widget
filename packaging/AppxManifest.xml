      <com:ComInterface>
        <com:ProxyStub Id="93022121-B6C9-4A22-90DB-763E24FD99E1" Path="Provider\Microsoft.Windows.Widgets.dll" />
        <com:Interface Id="38C3A963-DD93-479D-9276-04BF84EE1816" ProxyStubClsid="93022121-B6C9-4A22-90DB-763E24FD99E1" />
      </com:ComInterface>
